{
  "name": "Exo 0 - Notebooks / PYNQ",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "options": ["--platform=linux/amd64"]
  },
  "runArgs": ["--platform=linux/amd64"],
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/notebooks-venv/bin/python3"
      }
    }
  }
}
